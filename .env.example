# LearnLoop AI Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database URL
# For SQLite (default zero-config local run):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (production or when postgres daemon is running):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnloop_ai?schema=public"

# Google Gemini API Key (Keep server-side only)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Authentication Secret (JWT signing)
AUTH_SECRET="learnloop-super-secure-jwt-secret-key-change-in-prod-2026"

# Node Environment
NODE_ENV=development
