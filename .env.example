# LearnLoop AI - Environment Configuration Example

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration (Supabase Cloud PostgreSQL or local fallback)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# For local development database fallback:
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Keep server-side only)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Authentication Secret (JWT signing fallback)
AUTH_SECRET="learnloop-super-secure-jwt-secret-key-change-in-prod-2026"

# Node Environment
NODE_ENV=development
