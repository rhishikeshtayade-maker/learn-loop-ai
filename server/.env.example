# LearnLoop AI Server Environment Configuration Example

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Keep server-side only)
GEMINI_API_KEY=

# Supabase Cloud PostgreSQL & Auth (Server-side admin key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication Secret
AUTH_SECRET="learnloop-super-secure-jwt-secret-key-change-in-prod-2026"
